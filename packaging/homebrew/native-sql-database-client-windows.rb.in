cask "native-sql-database-client-windows" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "https://github.com/igor-alexandrov/native-sql-database-client-windows/releases/download/v#{version}/native-sql-database-client-windows-v#{version}-macos-universal.dmg"
  name "native-sql-database-client-windows"
  desc "Native database client for PostgreSQL, MySQL, SQLite and BigQuery"
  homepage "https://igor.works/native-sql-database-client-windows/"

  livecheck do
    url :url
    strategy :github_latest
  end

  auto_updates true
  depends_on :macos

  app "native-sql-database-client-windows.app"

  zap trash: [
    "~/.native-sql-database-client-windows",
    "~/Library/Application Support/dev.native-sql-database-client-windows.native-sql-database-client-windows",
    "~/Library/Caches/dev.native-sql-database-client-windows.native-sql-database-client-windows",
    "~/Library/Preferences/dev.native-sql-database-client-windows.native-sql-database-client-windows.plist",
    "~/Library/Saved Application State/dev.native-sql-database-client-windows.native-sql-database-client-windows.savedState",
  ]
end
