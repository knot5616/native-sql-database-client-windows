# Maintainer: Igor Alexandrov <igor.alexandrov@gmail.com>
pkgname=native-sql-database-client-windows-bin
pkgver=@VERSION@
pkgrel=@PKGREL@
pkgdesc="Native database client for PostgreSQL, MySQL and SQLite"
arch=('x86_64' 'aarch64')
url="https://github.com/igor-alexandrov/native-sql-database-client-windows"
license=('MIT')
# winit and glutin dlopen these at startup; a GUI-only application needs
# them all to run.
depends=('dbus' 'libglvnd' 'libxkbcommon' 'wayland' 'libx11')
optdepends=('libxkbcommon-x11: keyboard handling in X11 sessions')
provides=("native-sql-database-client-windows=$pkgver")
conflicts=('native-sql-database-client-windows')
options=('!debug' '!strip')
source_x86_64=("${url}/releases/download/v${pkgver}/native-sql-database-client-windows-v${pkgver}-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("${url}/releases/download/v${pkgver}/native-sql-database-client-windows-v${pkgver}-aarch64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('@AMD64_SHA256@')
sha256sums_aarch64=('@ARM64_SHA256@')

package() {
  local dir="${srcdir}/native-sql-database-client-windows-v${pkgver}-${CARCH}-unknown-linux-gnu"
  install -Dm755 "${dir}/native-sql-database-client-windows" "${pkgdir}/usr/bin/native-sql-database-client-windows"
  install -Dm644 "${dir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "${dir}/README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 "${dir}/packaging/linux/dev.native-sql-database-client-windows.native-sql-database-client-windows.desktop" \
    "${pkgdir}/usr/share/applications/dev.native-sql-database-client-windows.native-sql-database-client-windows.desktop"
  install -Dm644 "${dir}/packaging/linux/dev.native-sql-database-client-windows.native-sql-database-client-windows.svg" \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/dev.native-sql-database-client-windows.native-sql-database-client-windows.svg"
}
